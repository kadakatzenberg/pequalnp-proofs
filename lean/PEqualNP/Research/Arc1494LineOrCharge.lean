def directLine (w : Nat) : Nat :=
  ([0,1,3,9] : List Nat).foldl (fun s d => s + 2 ^ ((w+d)%13)) 0

def directTriples (w : Nat) : List Nat :=
  let a := 2 ^ (w%13)
  let b := 2 ^ ((w+1)%13)
  let c := 2 ^ ((w+3)%13)
  let d := 2 ^ ((w+9)%13)
  [b+c+d, a+c+d, a+b+d, a+b+c]

theorem lines_exact : lines = (List.range 13).map directLine := by decide +kernel
theorem triples_exact : triples = (List.range 13).flatMap directTriples := by decide +kernel

def pop13 (a : Nat) : Nat :=
  ((List.range 13).filter fun i => a.testBit i).length

def arc (a : Nat) : Bool := triples.all fun t => (a &&& t) != t

set_option maxRecDepth 65536 in
set_option maxHeartbeats 30000000 in
theorem four_arcs_exact :
    fourArcs = (List.range 8192).filter (fun a => pop13 a == 4 && arc a) := by
  decide +kernel

def negative (l : Nat) : List Nat := fourArcs.filter fun a => (a &&& l) == 0

theorem negative_count :
    lines.all (fun l => (negative l).length == 54) = true := by decide +kernel

def rotate (a k : Nat) : Nat :=
  (a * 2 ^ k) % 8192 + a / (2 ^ (13-k))

def representative (a : Nat) : Nat :=
  (List.range 13).foldl (fun s i => min s (rotate a i)) a

def two (a : Nat) : Bool := a != 0 && (a &&& (a-1)) != 0

set_option maxRecDepth 65536 in
set_option maxHeartbeats 30000000 in
theorem reps_exact :
    reps = (List.range 8192).filter (fun s => two s && representative s == s) := by
  decide +kernel

def submasks (s : Nat) : List Nat :=
  (List.range 13).foldl
    (fun acc i => if s.testBit i then acc ++ acc.map (fun a => a + 2 ^ i) else acc) [0]

def weights (s : Nat) : List (Nat × Nat) :=
  lines.map (fun l =>
    (l, if two (s &&& l) then ((negative l).filter fun a => (s &&& a) == 0).length else 0))

def partitionWeight (a b : Nat) (ws : List (Nat × Nat)) : Nat :=
  ws.foldl (fun t lw => if (a &&& lw.1) != 0 && (b &&& lw.1) != 0 then t + lw.2 else t) 0

def check (s : Nat) : Bool :=
  let ws := weights s
  if (ws.map Prod.snd).foldl (·+·) 0 ≤ 60 then true
  else (submasks s).all fun a => decide (partitionWeight a (s-a) ws ≤ 60)

-- Cyclic translations preserve lines, arcs, disjointness and charge.
-- Every support of size at least two has a representative in reps.
set_option maxRecDepth 65536 in
set_option maxHeartbeats 100000000 in
theorem all_representatives_pass : reps.all check = true := by
  decide +kernel

theorem tight_example : partitionWeight 3 4 (weights 7) = 60 := by decide +kernel

def decoderExamples : List (Nat × Nat × Nat) :=
  [(0,0,116),(1,1,201),(2,2,83),(3,3,135),(4,0,78),(5,1,141),
   (6,2,281),(7,3,71),(8,4,71),(9,5,71),(10,0,142),(11,1,77),(12,0,202)]

def decoderCheck (w p a : Nat) : Bool :=
  (lines[w]!).testBit p && arc a && ((lines[w]!) &&& a) == 0 &&
  (List.range 13).all (fun i =>
    i == w || !(lines[i]!).testBit p || ((lines[i]!) &&& a) != 0)

theorem all_decoder_separators :
    decoderExamples.all (fun t => decoderCheck t.1 t.2.1 t.2.2) = true := by decide +kernel

theorem decoder_examples_complete :
    decoderExamples.map Prod.fst = List.range 13 := by decide +kernel

