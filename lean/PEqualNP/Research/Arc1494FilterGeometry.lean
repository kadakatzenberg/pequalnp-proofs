def pop13 (a : Nat) : Nat :=
  ((List.range 13).filter fun i => a.testBit i).length
def arc (a : Nat) : Bool := triples.all fun t => (a &&& t) != t

def directLine (w : Nat) : Nat :=
  ([0,1,3,9] : List Nat).foldl (fun s d => s + 2 ^ ((w+d)%13)) 0

def directTriples (w : Nat) : List Nat :=
  let a := 2 ^ (w%13)
  let b := 2 ^ ((w+1)%13)
  let c := 2 ^ ((w+3)%13)
  let d := 2 ^ ((w+9)%13)
  [b+c+d, a+c+d, a+b+d, a+b+c]

theorem lines_exact : lines = (List.range 13).map directLine := by decide +kernel
theorem triples_exact : triples = (List.range 13).flatMap directTriples := by decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem arc_lists_exact :
    smallArcs = (List.range 8192).filter (fun a => decide (pop13 a ≤ 3) && arc a) ∧
    fourArcs = (List.range 8192).filter (fun a => pop13 a == 4 && arc a) := by
  decide +kernel

def good (l p : Nat) : List Nat :=
  fourArcs.filter fun a => (a &&& l) == 0 &&
    lines.all (fun v => v == l || !(v.testBit p) || (a &&& v) != 0)

def extendCheck (l p : Nat) : Bool :=
  let gs := good l p
  gs.length == 27 &&
    smallArcs.all (fun a => (a &&& l) != 0 || gs.any (fun b => (a &&& b) == a))

-- It suffices to check one line and each of its four points; translation
-- takes every incident point-line pair to one of these four cases.
set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem base_extensions :
    ([0,1,3,9] : List Nat).all (fun p => extendCheck 523 p) = true := by
  decide +kernel

def neighbors (a : Nat) : Nat :=
  (lines.filter fun l => (a &&& l) != 0).length

set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem expansion :
    (List.range 8192).all (fun a =>
      if 1 ≤ pop13 a ∧ pop13 a ≤ 11 then decide (pop13 a + 2 ≤ neighbors a)
      else if 12 ≤ pop13 a then neighbors a == 13 else true) = true := by
  decide +kernel

def split : List Nat := [1046,2092,4184,177,354,708,1416,2832,5664,3137,6274,4357,3,520]

set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem noncanonical_cover :
    split.length = 14 ∧
    (split.contains 1 = false) ∧ (split.contains 523 = false) ∧
    fourArcs.all (fun a => (List.range 13).all (fun p =>
      a.testBit p || split.any (fun s => s.testBit p && (s &&& a) == 0))) = true := by
  decide +kernel

