def pop13 (a : Nat) : Nat :=
  ((List.range 13).filter fun i => a.testBit i).length

def arc (a : Nat) : Bool :=
  triples.all fun t => (a &&& t) != t

def directTriples (w : Nat) : List Nat :=
  let a := 2 ^ (w%13)
  let b := 2 ^ ((w+1)%13)
  let c := 2 ^ ((w+3)%13)
  let d := 2 ^ ((w+9)%13)
  [b+c+d,a+c+d,a+b+d,a+b+c]

theorem triples_exact :
    triples = (List.range 13).flatMap directTriples := by decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem lists_exact :
    arcs0 = (List.range 8192).filter (fun a => a.testBit 0 && pop13 a == 4 && arc a) ∧
    pairs = (List.range 8192).filter (fun a => pop13 a == 2) := by
  decide +kernel

def hits (e : Nat) : Nat :=
  (List.range arcs0.length).foldl
    (fun n i => if (e &&& arcs0[i]!) != 0 then n + 2^i else n) 0

set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem hit_masks_exact : hitMasks = pairs.map hits := by decide +kernel

set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem fixed_point_two_pairs :
    hitMasks.all (fun a => hitMasks.all (fun b => (a &&& b) != 0)) = true := by
  decide +kernel

-- Via cyclic symmetry, any fixed point and any two pairs have a common
-- four-arc hitting both pairs. Thus three arbitrary pairs have an arc
-- transversal; four pairs sharing a point between any two do as well.
theorem singleton_obstruction (f n single : Nat)
    (hf : f ≤ 14) (hn : 7 ≤ n) (hs : 9 ≤ single) (hdisj : n+single ≤ f) :
    False := by omega

theorem size_six_impossible (r k spare : Nat)
    (hr : 4 ≤ r) (hk : k ≤ 13) (hspare : 129 ≤ spare)
    (h : 60*r + 6*k + 36*(13-k) + spare ≤ 438) :
    False := by omega

theorem seed_range (p r k : Nat)
    (hp : 4 ≤ p) (hpr : p ≤ r) (hk : k ≤ 13)
    (h : 60*r + 6*k + 36*(13-k) ≤ 438) :
    4 ≤ p ∧ p ≤ r ∧ r ≤ 6 ∧ 9 ≤ k := by omega

