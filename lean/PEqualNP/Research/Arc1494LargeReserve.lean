def pop13 (a : Nat) : Nat :=
  ((List.range 13).filter fun i => a.testBit i).length
def rotate (a k : Nat) : Nat :=
  (a * 2 ^ k) % 8192 + a / (2 ^ (13-k))
def representative (a : Nat) : Nat :=
  (List.range 13).foldl (fun s i => min s (rotate a i)) a
set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem reps_exact :
    reps = (List.range 8192).filter
      (fun s => decide (6 ≤ pop13 s) && representative s == s) := by
  decide +kernel
def two (a : Nat) : Bool := a != 0 && (a &&& (a-1)) != 0
def negative (l : Nat) : List Nat := fourArcs.filter fun a => (a &&& l) == 0
def coarse (s : Nat) : Nat :=
  lines.foldl (fun total l =>
    let w := ((negative l).filter fun a => (s &&& a) == 0).length
    total + (if two (s &&& l) then 10*w else 0) +
      (if (s &&& l) == l then w+36 else 0)) 0
set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem all_large_reps_pass :
    reps.all (fun s => decide (coarse s ≤ 471)) = true := by
  decide +kernel
theorem tight_example : coarse 183 = 471 := by decide +kernel
theorem large_deficit (capacity count : Nat)
    (h : capacity + 36*count ≤ 471) :
    129 + 36*count ≤ 600-capacity := by omega
